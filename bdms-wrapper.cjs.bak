    //发起HTTPS请求
    const req = https.request(options, (res) => {
        //声明变量收集响应数据（流式传输，需分段拼接）
        let responseData = '';

        //监听数据接收事件，分段收集数据
        res.on('data', (chunk) => {
            responseData += chunk;
        });

        //监听响应结束事件，处理完整响应数据
        res.on('end', () => {
            logger.info('请求状态码:', res.statusCode);
            logger.info('响应头:', res.headers);
            try {
                //解析JSON格式响应（接口返回application/json）
                const result = JSON.parse(responseData);
                logger.info('响应数据（格式化）:', JSON.stringify(result, null, 2));
            } catch (err) {
                //非JSON格式数据直接打印
                logger.info('响应数据（原始）:', responseData);
            }
        });
    });

    //监听请求错误事件
    req.on('error', (e) => {
        console.error('请求失败:', e.message);
    });

    //结束请求（GET请求无需发送请求体，end()表示请求完成）
    req.end();
}

