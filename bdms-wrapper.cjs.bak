function getFeedBogus(url, _xmst) {
    globalThis.xmst = _xmst
    // globalThis.navigator = { userAgent }
    // Object.defineProperty(globalThis.navigator, Symbol.toStringTag, {
    //     value: 'Navigator',
    //     configurable: true,
    //     writable: true,
    // })
    xhr = new XMLHttpRequest();
    xhr.bdmsInvokeList = [
        {
            "args": ["GET", url, true],
            func: function () { }
        },
        {
            "args": ["Accept", "application/json, text/plain, */*"],
            func: function () { }
        }
    ];
    xhr.invokeList = [
        {
            "name": "addEventListener",
            "args": ["load", function () { }]
        },
        {
            "name": "addEventListener",
            "args": ["error", function () { }]
        }
    ]
    xhr.send(null);
    return window.a_bogus;
}

